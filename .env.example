# Gryphon Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER SETTINGS
# =============================================================================
GRYPHON_HOST=127.0.0.1
GRYPHON_PORT=8000
GRYPHON_LOG_LEVEL=INFO
GRYPHON_DEBUG=false

# =============================================================================
# COMPILER SETTINGS
# =============================================================================
GRYPHON_COMPILE_ON_STARTUP=true
GRYPHON_COMPILED_OUTPUT_DIR=./compiled
GRYPHON_SWAGGER_CONFIG_FILE=./config/swaggers.yaml

# Compilation is deterministic and requires no model API key.
# LLM enrichment is retired and explicitly rejected in version 2.
# Leave GRYPHON_LLM_ENHANCE disabled; no provider configuration is required.
# Never include API keys in code or generated MCP client configuration.
# Configure upstream credentials only in this trusted process.
# Use environment references in the auth block of your swagger configuration.
GRYPHON_LLM_ENHANCE=false

# =============================================================================
# EXECUTOR SETTINGS
# =============================================================================
GRYPHON_LINT_ENABLED=false
GRYPHON_DOCKER_IMAGE=gryphon-sandbox:2.0.0
GRYPHON_EXECUTION_TIMEOUT_SECONDS=30
GRYPHON_MAX_OUTPUT_SIZE_BYTES=65536
GRYPHON_NETWORK_MODE=none

# Restricted execution is the default and does not require Docker.
# restricted: bounded Python subset with broker-mediated API calls.
# docker: optional offline full-Python compute; no credentials or networking.
GRYPHON_SANDBOX_MODE=restricted

# Admission, memory, and API call budgets apply independently.
# Overloaded executions fail explicitly rather than growing an unbounded queue.
GRYPHON_MAX_CONCURRENT_EXECUTIONS=4
GRYPHON_QUEUE_TIMEOUT_SECONDS=5
GRYPHON_MAX_TOOL_CALLS=50
GRYPHON_SANDBOX_MEMORY_BYTES=64000000
GRYPHON_DOCKER_RUNTIME=runsc
GRYPHON_MAX_RESPONSE_SIZE_BYTES=2097152

# =============================================================================
# CACHE SETTINGS
# =============================================================================
GRYPHON_CACHE_ENABLED=true
GRYPHON_CACHE_TTL_SECONDS=3600
GRYPHON_CACHE_MAX_ENTRIES=500
GRYPHON_CACHE_DB_PATH=./data/cache.db
GRYPHON_RUN_DB_PATH=./data/runs.db
GRYPHON_ARTIFACT_DIR=./data/artifacts
GRYPHON_RUN_MAX_ENTRIES=1000
GRYPHON_ARTIFACT_MAX_ENTRIES=100

# =============================================================================
# SECURITY
# =============================================================================
GRYPHON_MAX_CODE_SIZE_BYTES=65536
# Docker resources are enforced independently of the restricted runtime.
# Missing isolation runtimes fail closed; no automatic fallback occurs.
GRYPHON_CONTAINER_MEMORY_LIMIT=256m
# Optional additional exact-hostname restriction, encoded as a JSON array.
# Empty allows registered public API origins, not arbitrary sandbox networking.
GRYPHON_ALLOWED_DOMAINS=[]
GRYPHON_ALLOW_PRIVATE_NETWORKS=false

# =============================================================================
# API SERVER CREDENTIALS
# Resolve upstream credentials from environment references in auth configuration.
# =============================================================================

# For HTTP, export GRYPHON_HTTP_AUTH_TOKEN with at least 32 random characters.
GRYPHON_WEATHER_BASE_URL=https://api.open-meteo.com
GRYPHON_CONTEXT_BUDGET_BYTES=16384

# Writes require both this switch and exact administrator-approved operation IDs.
GRYPHON_ALLOW_WRITES=false
GRYPHON_ALLOWED_WRITE_OPERATIONS=[]

GRYPHON_SAAS_ADMIN_TOKEN=
GRYPHON_SAAS_DATABASE_URL=
GRYPHON_SAAS_PUBLIC_ORIGIN=
GRYPHON_SAAS_HOST=127.0.0.1
GRYPHON_SAAS_PORT=8000
GRYPHON_SAAS_STATE_DIR=./data/saas
GRYPHON_SAAS_ALLOW_INSECURE_HTTP=false
GRYPHON_SAAS_DOCKER_ENABLED=false
GRYPHON_POSTGRES_PASSWORD=
